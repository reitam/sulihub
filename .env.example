# SuliHub — opcionális környezeti változók (a docker-compose a projekt .env fájlját
# interpolációhoz automatikusan betölti; a fájl NEM kötelező).
#
# ⚠ A DATA_DIR / BACKUP_DIR / KRETA_DATA_DIR / KRETA_BACKUP_DIR host-oldali
#   kötet-útvonalak; ezeket a docker-compose.yml kezeli. Ne írd őket a konténer
#   env-jébe, mert az app egy nem létező konténerbeli útvonalon üres DB-t hozhat létre.
#   A publikus defaultok: ./data és ./backup.

# PROD éles üzemre, DEV fejlesztésre
APP_ENVIRONMENT=PROD

# ── ntfy push értesítés (opcionális) ─────────────────────────────────────────
# A topic neve MAGA a cím: a telefonos ntfy appban (vagy a ntfy.sh oldalon)
# ugyanerre a névre kell feliratkozni. Erre a névre bárki küldhet, és aki ismeri,
# olvashatja is — ezért hosszú, véletlen nevet használj (pl. kreta-3f9c1a7b...).
# A téma a data köteten lévő config.json `NTFY` blokkjában is beállítható; itt
# (env-ben) megadott érték mindig erősebb.
# NTFY_TOPIC=kreta-xxxxxxxxxxxxxxxxxxxx
# NTFY_URL=https://ntfy.sh
# NTFY_NOTIFY_SUCCESS=1      # 0 = sikeres futásról ne küldjön (hibáról igen)
# NTFY_INCLUDE_NAMES=0       # 1 = diáknevek is a push-ban (alapból nincs!)
