  "_comment_sync_mode": "api = bongeszo nelkul (alap); api_first = API + Playwright fallback (csak a :playwright image-ben); playwright = csak scraper (rollback).",
  "SYNC_MODE": "api",
  "SYNC_SHADOW": false,
  "DIGEST": {
    "_comment": "Esti osszefoglalo (KRE-8): gyermekenkent egy push a nap esemenyeivel. A felulet beallitasai felulirjak (app_meta).",
    "ENABLED": true,
    "TIME": "19:30",
    "INCLUDE_NAMES": true
  },
  "ENABLE_REWARDS": true,
  "NTFY": {
    "_comment": "Push ertesites. CSAK akkor hasznalja, ha a .env-ben NINCS NTFY_TOPIC (az env erosebb). Ures TOPIC = nincs ertesites. A topic neve maga a cim: az ntfy appban ugyanerre a nevere kell feliratkozni, ezert hosszu, veletlen nevet hasznalj. Ellenorzes: POST /api/ntfy/test",
    "TOPIC": "",
    "URL": "https://ntfy.sh",
    "NOTIFY_SUCCESS": true,
    "INCLUDE_NAMES": false
  },
  "SCHEDULER": {
    "ENABLED": true,
    "INTERVAL_MINUTES": 180,
    "START_HOUR": 0,
    "END_HOUR": 24,
    "STALE_ALERT_HOURS": 12
  },
